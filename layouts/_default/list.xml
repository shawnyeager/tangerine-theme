{{- /* Section/list feeds: summaries only */ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := .Pages -}}
{{- if not hugo.IsServer -}}
{{- $pages = where $pages "Draft" false -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- partial "rss-channel.xml" (dict "ctx" . "pages" $pages "fullContent" false "siteLevel" false) -}}
