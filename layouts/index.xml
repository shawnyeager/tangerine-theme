{{- /* Home feed: full content, filtered to the content_type section */ -}}
{{- $pages := where .Site.RegularPages "Section" .Site.Params.content_type -}}
{{- if not hugo.IsServer -}}
{{- $pages = where $pages "Draft" false -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- partial "rss-channel.xml" (dict "ctx" . "pages" $pages "fullContent" true "siteLevel" true) -}}
